<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="Item">
        <property name="id" type="int"/>
        <property name="idProductAbstract" type="int"/>
        <property name="abstractSku" type="string"/>
        <property name="abstractName" type="string" description="The name of the abstract product."/>
        <property name="name" type="string"/>
        <property name="url" type="string"/>
        <property name="taxRate" type="float"/>
        <property name="sku" type="string"/>
        <property name="productConcrete" type="ProductConcrete"/>
        <property name="concreteAttributes" type="array" singular="concreteAttribute"/>
        <property name="groupKey" type="string"/>
        <property name="brand" type="string" description="Brand of the product: its brand attribute in the order of the product storage, concrete localized over concrete over abstract localized over abstract, the localized ones in the current locale; set when the cart items are expanded."/>
        <property name="selectedVariantAttributes" type="array" singular="selectedVariantAttribute" description="The super attributes of the concrete product, attribute key to value, ordered by attribute key as strings, e.g. {&quot;color&quot;: &quot;Red&quot;, &quot;storage_capacity&quot;: &quot;64 GB&quot;}; set when the item is added to the cart, and from the order item's super attributes when an order is read."/>
    </transfer>

    <transfer name="ProductConcrete">
        <property name="idProductConcrete" type="int"/>
        <property name="sku" type="string"/>
        <property name="abstractSku" type="string"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="taxRate" type="float"/>
        <property name="attributes" type="array" singular="attribute"/>
        <property name="isActive" type="bool"/>
        <property name="localizedAttributes" type="LocalizedAttributes[]" singular="localizedAttributes"/>
    </transfer>

    <transfer name="CartChange">
        <property name="items" type="Item[]" singular="item"/>
        <property name="quote" type="Quote"/>
    </transfer>

    <transfer name="Quote">
        <property name="items" type="Item[]" singular="item"/>
        <property name="bundleItems" type="Item[]" singular="bundleItem"/>
        <property name="store" type="Store"/>
        <property name="originalSalesOrderItems" type="OriginalSalesOrderItem[]" singular="originalSalesOrderItem" strict="true"/>
    </transfer>

    <transfer name="OriginalSalesOrderItem" strict="true">
        <property name="sku" type="string"/>
    </transfer>

    <transfer name="CartPreCheckResponse">
        <property name="messages" type="Message[]" singular="message"/>
        <property name="isSuccess" type="bool"/>
    </transfer>

    <transfer name="Message">
        <property name="value" type="string"/>
        <property name="parameters" type="array" singular="parameters"/>
    </transfer>

    <transfer name="Locale">
        <property name="idLocale" type="int"/>
    </transfer>

    <transfer name="ProductAbstract">
        <property name="idProductAbstract" type="int"/>
        <property name="attributes" type="array" singular="attribute"/>
        <property name="localizedAttributes" type="LocalizedAttributes[]" singular="localizedAttributes"/>
    </transfer>

    <transfer name="LocalizedAttributes">
        <property name="name" type="string"/>
        <property name="attributes" type="array" singular="attribute"/>
        <property name="locale" type="Locale"/>
    </transfer>

    <transfer name="ProductUrlCriteriaFilter">
        <property name="productAbstractIds" type="int[]" singular="productAbstractId"/>
        <property name="idLocale" type="int"/>
    </transfer>

    <transfer name="Url">
        <property name="url" type="string"/>
        <property name="fkResourceProductAbstract" type="int"/>
    </transfer>

    <transfer name="ProductCriteria">
        <property name="idStore" type="int"/>
        <property name="isActive" type="bool"/>
        <property name="skus" type="string[]" singular="sku"/>
        <property name="withoutAdditionalProductData" type="bool" strict="true"/>
    </transfer>

    <transfer name="Store">
        <property name="idStore" type="int"/>
        <property name="name" type="string"/>
    </transfer>

    <transfer name="CheckoutResponse">
        <property name="isSuccess" type="bool"/>
        <property name="errors" type="CheckoutError[]" singular="error"/>
    </transfer>

    <transfer name="CheckoutError">
        <property name="message" type="string"/>
        <property name="parameters" type="array" singular="parameters"/>
        <property name="errorType" type="string"/>
        <property name="groupKey" type="string"/>
    </transfer>

</transfers>
